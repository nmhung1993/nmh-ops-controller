// QA layout check v2: precise occlusion detection via elementFromPoint
const { chromium } = require('playwright');

const BASE = 'http://127.0.0.1:3303';
const out = { pages: [] };

async function analyze(page, label) {
  const report = {
    label,
    viewport: page.viewportSize(),
    pageOverflowX: 0,
    truncated: [],
    occluded: [],
    bodyScrollInfo: '',
  };
  const data = await page.evaluate(() => {
    const vw = document.documentElement.clientWidth;
    const docOverflow = document.documentElement.scrollWidth > vw + 1;

    // 1. Get all leaf text elements (no element children, has visible text)
    const candidates = [];
    const all = document.querySelectorAll('body *');
    for (const el of all) {
      if (el.children.length > 0) continue;
      const text = (el.textContent || '').replace(/\s+/g, ' ').trim();
      if (!text) continue;
      const r = el.getBoundingClientRect();
      const st = window.getComputedStyle(el);
      if (st.display === 'none' || st.visibility === 'hidden' || r.width === 0 || r.height === 0) continue;
      if (r.right < 0 || r.left > vw || r.bottom < 0) continue; // offscreen (closed drawer)
      candidates.push({ el, text: text.slice(0, 48), r });
    }

    // 2. Truncation: overflow hidden / ellipsis with hidden overflow content
    const truncated = [];
    const seenTrunc = new Set();
    for (const { el, text, r } of candidates) {
      const st = window.getComputedStyle(el);
      const clips = (st.overflow === 'hidden' || st.textOverflow === 'ellipsis' || st.whiteSpace === 'nowrap');
      if (!clips) continue;
      const effective = el.scrollWidth;
      if (effective > el.clientWidth + 4 || (el.scrollHeight > el.clientHeight + 4 && st.overflow === 'hidden')) {
        const key = el.tagName + text;
        if (seenTrunc.has(key)) continue;
        seenTrunc.add(key);
        truncated.push({ tag: el.tagName, text, clientW: el.clientWidth, scrollW: el.scrollWidth });
      }
    }

    // 3. Occlusion: is the topmost element at the text center part of the text's own subtree?
    const occluded = [];
    const seenOcc = new Set();
    for (const { el, text, r } of candidates) {
      const cx = Math.min(Math.max(r.left + r.width / 2, 2), vw - 2);
      const cy = Math.min(Math.max(r.top + r.height / 2, 2), window.innerHeight - 2);
      let probeY = cy;
      let points = 0, occl = 0;
      for (const fx of [r.left + 1.5, (r.left + r.right) / 2, r.right - 1.5]) {
        const x = Math.min(Math.max(fx, 2), vw - 2);
        const hit = document.elementFromPoint(x, probeY);
        if (!hit) continue;
        points++;
        if (hit !== el && !el.contains(hit) && !hit.contains(el)) occl++;
      }
      if (points > 0 && occl / points >= 0.6) {
        const key = el.tagName + text;
        if (seenOcc.has(key)) continue;
        seenOcc.add(key);
        let topEl = document.elementFromPoint(cx, probeY);
        occluded.push({
          tag: el.tagName, text,
          at: `${Math.round(r.left)},${Math.round(r.top)} ${Math.round(r.width)}x${Math.round(r.height)}`,
          coveredBy: topEl ? `${topEl.tagName}.${(topEl.className || '').toString().slice(0, 60)}` : 'none'
        });
      }
    }
    return { docOverflow, truncated, occluded };
  });
  report.pageOverflowX = data.docOverflow;
  report.truncated = data.truncated.slice(0, 25);
  report.occluded = data.occluded.slice(0, 25);
  out.pages.push(report);
  console.log(`\n=== ${label} (${report.viewport.width}x${report.viewport.height}) ===`);
  console.log(`  page horizontal overflow: ${data.docOverflow ? 'YES' : 'no'}`);
  if (data.truncated.length) {
    console.log(`  TRUNCATED TEXT (${data.truncated.length}):`);
    for (const t of data.truncated.slice(0, 10)) console.log(`    <${t.tag}> "${t.text}" client=${t.clientW} scroll=${t.scrollW}`);
  }
  if (data.occluded.length) {
    console.log(`  OCCLUDED TEXT (${data.occluded.length}):`);
    for (const o of data.occluded.slice(0, 10)) console.log(`    <${o.tag}> "${o.text}" at ${o.at} coveredBy ${o.coveredBy}`);
  }
  if (!data.docOverflow && !data.truncated.length && !data.occluded.length) console.log('  CLEAN');
  return report;
}

(async () => {
  const browser = await chromium.launch();
  const context = await browser.newContext({ viewport: { width: 900, height: 600 } });
  const page = await context.newPage();
  page.on('console', msg => { if (msg.type() === 'error') console.log('CONSOLE ERROR:', msg.text()); });
  page.on('pageerror', err => console.log('PAGE ERROR:', err.message));

  console.log(`Opening ${BASE} at 900x600`);
  await page.goto(BASE, { waitUntil: 'networkidle' });

  // Login if needed
  const inputs = await page.locator('input').count();
  if (inputs > 0 && await page.getByText('Windows Controller Fleet', { exact: false }).count() > 0) {
    console.log('Signing in as demo-admin');
    await page.locator('input[type="text"], input[name="username"]').first().fill('demo-admin');
    await page.locator('input[type="password"]').fill('demo-password-2026');
    await page.getByRole('button', { name: /đăng nhập|sign in/i }).click();
    await page.waitForSelector('text=Danh sách máy', { timeout: 10000 });
    await page.waitForTimeout(1800);
  }

  const gotoHash = async hash => {
    await page.evaluate(h => { location.hash = h; }, hash);
    await page.waitForTimeout(1200);
  };

  // --- FLEET light 900x600 ---
  await gotoHash('#fleet');
  await analyze(page, 'FLEET light (mobile 900x600)');

  // --- Toggle dark via hamburger drawer ---
  const menuBtn = page.locator('button[aria-label="Open navigation"]');
  await menuBtn.click();
  await page.waitForTimeout(600);
  const darkInDrawer = page.locator('.MuiDrawer-root button', { hasText: /Dark|Tối/i }).first();
  // Fallback: any outlined button containing Dark/Tối
  const darkSelector = page.locator('button:has-text("Dark"), button:has-text("Tối")').first();
  const darkCount = await darkSelector.count();
  if (darkCount) { await darkSelector.click(); await page.waitForTimeout(900); }
  // Close drawer by clicking a nav item
  await page.locator('.MuiDrawer-root a, .MuiDrawer-root [role="button"]:has-text("Danh sách máy")').first().click().catch(() => {});
  await page.keyboard.press('Escape');
  await page.waitForTimeout(800);

  await analyze(page, 'FLEET dark (mobile 900x600)');

  // --- Dashboard dark 900x600 ---
  await gotoHash('#dashboard');
  await page.waitForTimeout(1500);
  await analyze(page, 'DASHBOARD dark (mobile 900x600)');

  // --- Desktop viewport ---
  await page.setViewportSize({ width: 1280, height: 768 });
  await page.waitForTimeout(1200);
  await gotoHash('#fleet');
  await page.waitForTimeout(800);
  await analyze(page, 'FLEET dark (desktop 1280x768)');
  await gotoHash('#dashboard');
  await page.waitForTimeout(1500);
  await analyze(page, 'DASHBOARD dark (desktop 1280x768)');

  // Toggle light on desktop
  const toggle = page.locator('button[aria-label*="sáng"], button[aria-label*="light"], button[aria-label*="Light"]').first();
  if (await toggle.count()) { await toggle.click(); await page.waitForTimeout(900); }
  await analyze(page, 'DASHBOARD light (desktop 1280x768)');

  // --- Phone viewport ---
  await page.setViewportSize({ width: 375, height: 667 });
  await page.waitForTimeout(1200);
  await gotoHash('#dashboard');
  await page.waitForTimeout(1200);
  await analyze(page, 'DASHBOARD light (phone 375x667)');
  await gotoHash('#fleet');
  await page.waitForTimeout(1000);
  await analyze(page, 'FLEET light (phone 375x667)');

  await page.screenshot({ path: 'qa-final-state.png' });
  console.log('\nScreenshot: qa-final-state.png');
  console.log('\n=== SUMMARY ===');
  for (const p of out.pages) {
    console.log(`${p.label}: hOverflow=${p.pageOverflowX} truncated=${p.truncated.length} occluded=${p.occluded.length}`);
  }
  await browser.close();
})().catch(err => console.error('FATAL:', err), () => process.exit(1));